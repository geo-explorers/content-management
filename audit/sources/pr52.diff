+
+const runStatus = { complete: false, state: "running", startedAt: new Date().toISOString(), window: { since: SINCE_ISO, until: new Date(UNTIL * 1000).toISOString() }, space: spaceKey, proposalCoverage: {}, issues: [], warnings: [] };
