 "bodyBlocks": [
  {
   "id": "2c2b2aa91f1b4fa5b592c7c0515ca715",
   "position": "a08tN",
   "toEntity": {
    "id": "044a7b3ad4dd4b878fbf3addf74286df",
    "valuesList": [
     {
      "text": "The goal of this bounty is to fill US politics space with structured data that would take too long to add by hand, e.g. lists, records, datasets, and reference information from public sources."
     }
    ]
   }
  },
  {
   "id": "13d8f3b8a95845179131537fd12d72c5",
   "position": "a10Th",
   "toEntity": {
    "id": "55188a8e77b143a085a55b6fd2ebaeaa",
    "valuesList": [
     {
      "text": "**How to do it:**"
     }
    ]
   }
  },
  {
   "id": "768b7e86136f477091cdc40f34eb58bb",
   "position": "a2218",
   "toEntity": {
    "id": "a14db9ed284a4c138073fff1f06bff99",
    "valuesList": [
     {
      "text": "1. Check for requested subjects and public sources following this link: https://www.geobrowser.io/space/4582fbbee28a16589154f7e36f1ee3c5/f0a7cf787aa2412ca6bc38b5d2c56757"
     }
    ]
   }
  },
  {
   "id": "32ab8fb74279475c837e7f7f3b4e1bb1",
   "position": "a32E6",
   "toEntity": {
    "id": "cf3e4e438afd4faf81b12ed127638beb",
    "valuesList": [
     {
      "text": "2. Prepare it, clean it to match the space's existing types and properties, and import it (CSV import supported). Check with the bounty maintainer before imports so the structure fits the space's setup, and always record the origin of the data."
     }
    ]
   }
  },
  {
   "id": "836e04dc5534496da9cb345f32446170",
   "position": "a490x",
   "toEntity": {
    "id": "4d7fe50a494c4839beec5b45ba5fa7bf",
    "valuesList": [
     {
      "text": "3. Message about it on US politics channel in discord."
     }
    ]
   }
  },
  {
   "id": "2df3785f6fa04daf9d5f0f8a5ae1ffe4",
   "position": "a59ah",
   "toEntity": {
    "id": "52b9301ef28a45c1b12ca30312c8e81e",
    "valuesList": [
     {
      "text": "4. Implement editors' recommended revisions and earn points."
     }
    ]
   }
  },
  {
   "id": "067f5be4ae674577974e2def21ed9ca7",
   "position": "a6CH0",
   "toEntity": {
    "id": "474a91dc677f4518b34f870834af52dd",
    "valuesList": [
     {
      "text": "**Questions?** Reach out to the bounty maintainer Dan."
     }
    ]
   }
  }
