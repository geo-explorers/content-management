# Geo wallet credentials. Needed only for publishing (actionable skills and the entity toolkit).
# Read-only skills (geo-query, geo-press-review, ontology-advisor, geo-describe) need no keys at all.
#
# Get your private key at https://www.geobrowser.io/export-wallet (click "Copy key",
# NOT the wallet-address copy button; they are different values).
#
# IMPORTANT: fill this file in yourself, by hand, in a text editor.
# Never paste your private key into an AI chat, and never ask an assistant to write it here.
GEO_PRIVATE_KEY="0x<private_key>"

# Legacy alias. Older scripts also accept PK_SW; GEO_PRIVATE_KEY is the canonical name.
# PK_SW="0x<private_key>"

# The space that publishing scripts target by default. Normally your personal space:
# open your space in the browser and copy the long hex id from geobrowser.io/space/<this part>.
DEMO_SPACE_ID="<space_id_of_the_personal_space>"
